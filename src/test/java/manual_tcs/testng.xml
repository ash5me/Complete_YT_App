<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MyTube Manual Test Automation Suite" verbose="2" parallel="false" preserve-order="true">
    <test name="All Manual Test Cases - TC01 to TC29">
        <groups>
            <run>
                <include name="navigation"/>
                <include name="theme"/>
                <include name="channel-profile"/>
                <include name="subscription"/>
                <include name="search"/>
                <include name="filter-sort"/>
                <include name="video-cards"/>
            </run>
        </groups>
        <classes>
            <class name="manual_tcs.ManualTCTest"/>
        </classes>
    </test>
</suite>
